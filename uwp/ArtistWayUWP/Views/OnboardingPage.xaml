<Page
    x:Class="ArtistWayUWP.Views.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArtistWayUWP.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer Padding="24">
        <StackPanel VerticalAlignment="Center" MaxWidth="480" HorizontalAlignment="Stretch">

            <StackPanel x:Name="ReturningUserPanel">
                <TextBlock x:Name="AppTitleText1" Style="{StaticResource HeaderTextBlockStyle}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock x:Name="ReturningUserQuestionText" Style="{StaticResource BodyTextBlockStyle}"
                           TextWrapping="Wrap" TextAlignment="Center" Opacity="0.85" Margin="0,16,0,4" />
                <TextBlock x:Name="ReturningUserDescriptionText"
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                           Opacity="0.7" Margin="0,0,0,24" />
                <Button x:Name="ReturningUserLoginButton"
                        Click="ReturningUserLogin_Click" HorizontalAlignment="Stretch" />
                <TextBlock x:Name="ReturningUserStatusText" Style="{StaticResource CaptionTextBlockStyle}"
                           Opacity="0.8" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                           Visibility="Collapsed" />
                <Button x:Name="SkipLoginButton" Click="Next_Click"
                        HorizontalAlignment="Stretch" Margin="0,12,0,0" />
            </StackPanel>

            <StackPanel x:Name="WelcomePanel" Visibility="Collapsed">
                <TextBlock x:Name="WelcomeQuoteText"
                           Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" TextAlignment="Center" Opacity="0.85" />
                <TextBlock x:Name="AppTitleText2" Style="{StaticResource HeaderTextBlockStyle}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,0" />
                <TextBlock x:Name="WelcomeDescriptionText"
                           Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                           Opacity="0.85" Margin="0,16,0,0" />
                <Button x:Name="WelcomeStartButton" Click="Next_Click" HorizontalAlignment="Stretch" Margin="0,24,0,0" />
            </StackPanel>

            <StackPanel x:Name="NameDatePanel" Visibility="Collapsed">
                <TextBlock x:Name="NameDateTitleText" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="NameDateSubtitleText" Style="{StaticResource BodyTextBlockStyle}"
                           Opacity="0.85" TextWrapping="Wrap" Margin="0,4,0,16" />
                <TextBlock x:Name="NameLabelText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <TextBox x:Name="NameBox" Margin="0,4,0,16" />
                <TextBlock x:Name="StartDateLabelText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <DatePicker x:Name="StartDatePicker" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton1" Grid.Column="0" Click="Back_Click" />
                    <Button x:Name="ContinueButton1" Grid.Column="1" Click="Next_Click" Margin="12,0,0,0" HorizontalAlignment="Stretch" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="RitualsPanel" Visibility="Collapsed">
                <TextBlock x:Name="RitualsTitleText" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="RitualsSubtitleText" Style="{StaticResource BodyTextBlockStyle}"
                           Opacity="0.85" TextWrapping="Wrap" Margin="0,4,0,16" />
                <TextBlock x:Name="MorningPagesSectionText" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                <TextBlock x:Name="MpTimeLabelText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <TimePicker x:Name="MorningPagesTimePicker" HorizontalAlignment="Stretch" Margin="0,4,0,16" />
                <TextBlock x:Name="ArtistDateSectionText" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                <TextBlock x:Name="AdWeekdayLabelText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <ComboBox x:Name="ArtistDateDayCombo" HorizontalAlignment="Stretch" Margin="0,4,0,16" />
                <TextBlock x:Name="AdTimeLabelText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <TimePicker x:Name="ArtistDateTimePicker" HorizontalAlignment="Stretch" Margin="0,4,0,16" />
                <TextBlock x:Name="CheckinSectionText" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,0,0,4" />
                <TextBlock x:Name="CiWeekdayLabelText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <ComboBox x:Name="CheckinDayCombo" HorizontalAlignment="Stretch" Margin="0,4,0,16" />
                <TextBlock x:Name="CiTimeLabelText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                <TimePicker x:Name="CheckinTimePicker" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton2" Grid.Column="0" Click="Back_Click" />
                    <Button x:Name="ContinueButton2" Grid.Column="1" Click="Next_Click" Margin="12,0,0,0" HorizontalAlignment="Stretch" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="ContractPanel" Visibility="Collapsed">
                <TextBlock x:Name="ContractTitleText" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="ContractDescriptionText"
                           Style="{StaticResource BodyTextBlockStyle}" Opacity="0.85" TextWrapping="Wrap" Margin="0,4,0,16" />
                <Border Style="{StaticResource CardBorderStyle}">
                    <TextBlock x:Name="ContractText" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" Opacity="0.9" />
                </Border>
                <TextBlock x:Name="SignatureLabelText" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Margin="0,12,0,4" />
                <TextBox x:Name="SignatureBox" />
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackButton3" Grid.Column="0" Click="Back_Click" />
                    <Button x:Name="FinishButton" Grid.Column="1" Click="Finish_Click" Margin="12,0,0,0" HorizontalAlignment="Stretch" />
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
