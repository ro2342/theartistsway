<Page
    x:Class="ArtistWayUWP.Views.FerramentasPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArtistWayUWP.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <!-- Faixa cinza atrás do cabeçalho de abas (mesma brush da
             HeaderBar do shell) — continua a barra cinza que já vem do
             título "Recursos", igual ao Settings nativo da Microsoft. -->
        <Border VerticalAlignment="Top" Height="48"
                Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}" />

        <!-- PivotItems (uma aba por semana + "Geral") são montados
             dinamicamente no code-behind a partir de
             ContentStore.Content.ToolConfigs, agrupados por Week — a
             lista fica grande demais (quase 80 ferramentas na leva
             completa) pra hardcodar botão por botão em XAML. -->
        <Pivot x:Name="RecursosPivot" />
    </Grid>
</Page>
